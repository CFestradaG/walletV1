rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and private subcollections (Per-User Isolation)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.id == userId;
      allow delete: if false;

      // Settings
      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(settingsId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(settingsId);
      }

      // Accounts: direct client writes on Spark, limited to the authenticated owner.
      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(accountId)
          && request.resource.data.id == accountId
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.type in ['cash', 'bank', 'savings', 'credit_card']
          && request.resource.data.currentBalance is number
          && request.resource.data.initialBalance is number
          && request.resource.data.currentBalance < 1000000000000
          && request.resource.data.currentBalance > -1000000000000
          && request.resource.data.initialBalance < 1000000000000
          && request.resource.data.initialBalance > -1000000000000
          && request.resource.data.status in ['active', 'archived'];
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      // Categories
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(categoryId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(categoryId);
      }

      // Financial Periods
      match /periods/{periodId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(periodId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(periodId);
      }

      // Transactions: transaction and impacted accounts are committed by client transactions.
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(transactionId)
          && request.resource.data.id == transactionId
          && request.resource.data.userId == userId
          && request.resource.data.type in ['expense', 'income', 'transfer']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 1000000000000
          && request.resource.data.currency is string
          && request.resource.data.currency.size() == 3
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && transactionAccountsExist(userId, request.resource.data);
        allow delete: if isOwner(userId)
          && isValidId(transactionId)
          && resource.data.userId == userId;
      }

      // Budgets
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(budgetId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }

      // Saved transaction templates belong to one authenticated user.
      match /templates/{templateId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(templateId)
          && request.resource.data.id == templateId
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(templateId);
      }

      // Financial Health Reports: monthly and weekly summaries per user
      match /financial_reports/{reportId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(reportId)
          && request.resource.data.id == reportId
          && request.resource.data.userId == userId
          && request.resource.data.schemaVersion is number
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100;
        allow delete: if isOwner(userId) && isValidId(reportId);
      }
    }

    function transactionAccountsExist(userId, data) {
      return data.type == 'transfer'
        ? data.originAccountId is string
          && data.destinationAccountId is string
          && data.originAccountId != data.destinationAccountId
          && existsAfter(/databases/$(database)/documents/users/$(userId)/accounts/$(data.originAccountId))
          && existsAfter(/databases/$(database)/documents/users/$(userId)/accounts/$(data.destinationAccountId))
        : data.accountId is string
          && existsAfter(/databases/$(database)/documents/users/$(userId)/accounts/$(data.accountId));
    }
  }
}
